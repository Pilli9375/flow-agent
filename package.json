{
  "name": "flow-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lean Google Flow automation: one core, an MCP server and a CLI.",
  "bin": {
    "flow-agent": "dist/cli.js"
  },
  "scripts": {
